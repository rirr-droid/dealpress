# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe Configuration (Phase 3)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Product/Price IDs
# Create products in Stripe Dashboard → Products
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_PRO_PRODUCT_ID=prod_xxx

# Stripe Webhook Secret
# Get from: Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend Configuration (Phase 4)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Email sender (use verified domain in production)
# For development, use: DealPress <onboarding@resend.dev>
# For production, use: DealPress <approvals@yourdomain.com>
RESEND_FROM_EMAIL=DealPress <onboarding@resend.dev>

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secret for email approval tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-secret-key-here
